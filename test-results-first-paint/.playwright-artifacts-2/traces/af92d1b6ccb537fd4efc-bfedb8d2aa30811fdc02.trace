n .m3-dlg .m3-dlg__title:focus,\n.v-application .m3-dlg .m3-dlg__title:focus-visible,\n.v-application .v-dialog.m3-dlg-frame:focus-visible {\n  outline: none;\n}\n\n.m3-dlg__close {\n  display: inline-flex;\n  flex: none;\n  align-items: center;\n  justify-content: center;\n  width: 32px;\n  height: 32px;\n  margin: -4px -6px 0 0;\n  border-radius: 50%;\n  background: var(--m3d-surface-2);\n  color: var(--m3d-text-muted);\n  cursor: pointer;\n}\n.m3-dlg__close:hover:not(:disabled) {\n  color: var(--m3d-text);\n}\n.m3-dlg__close:disabled {\n  opacity: 0.4;\n  cursor: default;\n}\n.m3-dlg__close .frame-icon {\n  width: 16px;\n  height: 16px;\n}\n\n.m3-dlg__body {\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n  min-width: 0;\n}\n\n.v-application .m3-dlg p {\n  margin-bottom: 0;\n}\n\n.m3-dlg__text {\n  margin: 0;\n  color: var(--m3d-text-muted);\n  font-size: 14px;\n  white-space: pre-line;\n  overflow-wrap: anywhere;\n}\n\n.m3-dlg__note {\n  margin: 0;\n  color: var(--m3d-text-subtle);\n  font-size: 12px;\n}\n\n.m3-dlg__error {\n  margin: 0;\n  color: var(--m3d-danger);\n  font-size: 13px;\n}\n\n.m3-dlg__panel {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  padding: 14px 16px;\n  border-radius: 16px;\n  background: var(--m3d-surface-2);\n}\n\n.m3-dlg__actions {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 8px;\n}\n.m3-dlg__actions .cbtn {\n  min-width: 96px;\n}\n\n.m3-dlg__grow {\n  flex: 1 1 auto;\n}\n\n@media (max-width: 480px) {\n  .m3-dlg {\n    padding: 20px 18px 18px;\n  }\n\n  .m3-dlg__actions {\n    flex-direction: column-reverse;\n    align-items: stretch;\n  }\n  .m3-dlg__actions .cbtn {\n    width: 100%;\n  }\n\n  .m3-dlg__grow {\n    display: none;\n  }\n}\n.m3-field {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.m3-field__label {\n  color: var(--m3d-text-muted);\n  font-size: 13px;\n  font-weight: 600;\n}\n\n.m3-field__box {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  height: 52px;\n  padding: 0 14px;\n  border-radius: 14px;\n  background: var(--m3d-surface-2);\n  color: var(--m3d-text-muted);\n  cursor: text;\n  transition: box-shadow var(--m3d-duration-fast) var(--m3d-ease);\n}\n.m3-field__box input {\n  flex: 1 1 0;\n  min-width: 0;\n  border: 0;\n  outline: none;\n  background: transparent;\n  color: var(--m3d-text);\n  font: inherit;\n  font-size: 15px;\n}\n.m3-field__box input::placeholder {\n  color: var(--m3d-text-subtle);\n}\n.m3-field__box:focus-within {\n  box-shadow: inset 0 0 0 2px var(--m3d-accent);\n}\n\n.m3-field__box--ok:not(:focus-within) {\n  box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--m3d-success) 55%, transparent);\n}\n\n.m3-field__box--err:not(:focus-within) {\n  box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--m3d-danger) 55%, transparent);\n}\n\n.m3-field__box--mono input {\n  font-family: var(--m3d-font-mono);\n}\n\n.v-application .m3-field .m3-field__box input:focus,\n.v-application .m3-field .m3-field__box input:focus-visible {\n  outline: none;\n}\n\n.v-application .v-card.app-dlg {\n  border: 0 !important;\n  border-radius: inherit !important;\n  background-color: var(--m3d-surface) !important;\n  color: var(--m3d-text);\n}\n.v-application .v-card.app-dlg > .app-dlg__head {\n  display: flex;\n  flex-wrap: nowrap;\n  align-items: flex-start;\n  gap: 12px;\n  padding: 22px 22px 8px !important;\n  border: 0 !important;\n  background: transparent !important;\n  box-shadow: none !important;\n}\n.v-application .v-card.app-dlg > .v-card__text {\n  padding: 8px 22px 12px !important;\n  color: var(--m3d-text);\n}\n.v-application .v-card.app-dlg > .app-dlg__actions {\n  flex-wrap: wrap;\n  gap: 8px;\n  padding: 8px 22px 20px !important;\n}\n.v-application .v-card.app-dlg > .app-dlg__actions > .v-btn,\n.v-application .v-card.app-dlg > .app-dlg__actions > .cbtn {\n  margin: 0 !important;\n}\n.v-application .v-card.app-dlg > .app-dlg__actions > .v-btn:not(.v-btn--icon):not(.v-btn--fab) {\n  height: 40px !important;\n  padding: 0 16px !important;\n  border-radius: 999px !important;\n  background-color: var(--m3d-surface-2) !important;\n  color: var(--m3d-text) !important;\n  font-size: 14px;\n  font-weight: 600;\n  letter-spacing: 0;\n  text-transform: none;\n}\n.v-application .v-card.app-dlg > .app-dlg__actions > .v-btn:not(.v-btn--icon):not(.v-btn--fab).v-btn--text, .v-application .v-card.app-dlg > .app-dlg__actions > .v-btn:not(.v-btn--icon):not(.v-btn--fab).warning--text {\n  background-color: transparent !important;\n  color: var(--m3d-text-muted) !important;\n}\n.v-application .v-card.app-dlg > .app-dlg__actions > .v-btn:not(.v-btn--icon):not(.v-btn--fab).primary:not(.v-btn--text) {\n  background-color: var(--m3d-accent) !important;\n  color: var(--m3d-on-accent, #00201e) !important;\n}\n.v-application .v-card.app-dlg > .app-dlg__actions > .v-btn:not(.v-btn--icon):not(.v-btn--fab).error, .v-application .v-card.app-dlg > .app-dlg__actions > .v-btn:not(.v-btn--icon):not(.v-btn--fab).error--text {\n  background-color: color-mix(in srgb, var(--m3d-danger) 16%, transparent) !important;\n  color: var(--m3d-danger) !important;\n}\n.v-application .v-card.app-dlg > .app-dlg__actions > .v-btn:not(.v-btn--icon):not(.v-btn--fab).v-btn--disabled {\n  opacity: 0.45;\n}\n\n.app-dlg__titles {\n  display: flex;\n  flex: 1 1 auto;\n  flex-direction: column;\n  gap: 4px;\n  min-width: 0;\n}\n\n.app-dlg__title {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  margin: 0;\n  color: var(--m3d-text);\n  font-size: 19px;\n  font-weight: 600;\n  line-height: 1.3;\n  word-break: normal;\n  overflow-wrap: anywhere;\n}\n\n.v-application .app-dlg__sub {\n  margin: 0;\n  color: var(--m3d-text-muted);\n  font-size: 13px;\n  font-weight: 400;\n  line-height: 1.45;\n}\n\n.stiles {\n  display: grid;\n  grid-template-columns: repeat(12, minmax(0, 1fr));\n  gap: 16px;\n  align-items: start;\n}\n\n.stile {\n  grid-column: span 12;\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n  min-width: 0;\n  padding: 18px;\n  border-radius: 22px;\n  background: var(--m3d-surface);\n  color: var(--m3d-text);\n}\n\n.stile--4 {\n  grid-column: span 4;\n}\n\n.stile--6 {\n  grid-column: span 6;\n}\n\n.stile--8 {\n  grid-column: span 8;\n}\n\n.stile__head {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  min-height: 28px;\n  font-size: 16px;\n  font-weight: 700;\n}\n.stile__head h2 {\n  margin: 0;\n  font-size: inherit;\n  font-weight: inherit;\n}\n.stile__head .frame-icon,\n.stile__head svg:first-child {\n  flex: none;\n  color: var(--m3d-text-muted);\n}\n\n.stile__aside {\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n  margin-left: auto;\n}\n\n.stile__note {\n  margin: 0;\n  color: var(--m3d-text-muted);\n  font-size: 13px;\n}\n\n.stile__group-title {\n  margin: 0 0 8px;\n  font-size: 13px;\n  font-weight: 700;\n  color: var(--m3d-text-muted);\n}\n\n.slist {\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n  border-radius: 18px;\n  background: var(--m3d-surface);\n}\n\n.stile .slist {\n  border-radius: 0;\n  background: transparent;\n}\n\n.srow {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  min-height: 52px;\n  padding: 8px 16px;\n}\n.srow + .srow {\n  border-top: 1px solid var(--m3d-border);\n}\n\n.stile .srow {\n  padding-right: 0;\n  padding-left: 0;\n}\n\n.srow__ico {\n  display: grid;\n  flex: none;\n  place-items: center;\n  width: 36px;\n  height: 36px;\n  border-radius: 10px;\n  background: var(--m3d-surface-2);\n  color: var(--m3d-text-muted);\n}\n\n.srow__text {\n  flex: 1 1 auto;\n  min-width: 0;\n  font-size: 14px;\n}\n.srow__text b,\n.srow__text .srow__t {\n  display: block;\n  overflow: hidden;\n  font-size: 15px;\n  font-weight: 600;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.srow__text small,\n.srow__text .srow__s {\n  display: block;\n  color: var(--m3d-text-muted);\n  font-size: 12px;\n}\n\n.srow__v {\n  flex: none;\n  max-width: 55%;\n  font-size: 14px;\n  font-weight: 600;\n  text-align: right;\n  overflow-wrap: anywhere;\n}\n\n.srow__act {\n  display: inline-flex;\n  flex: none;\n  align-items: center;\n  gap: 8px;\n}\n\n.sbar {\n  height: 8px;\n  overflow: hidden;\n  border-radius: 4px;\n  background: var(--m3d-surface-2);\n}\n.sbar i {\n  display: block;\n  height: 100%;\n  background: var(--m3d-accent);\n}\n\n.cbtn--sm {\n  height: 32px;\n  padding: 0 12px;\n  font-size: 13px;\n}\n\n.scallout {\n  display: flex;\n  align-items: flex-start;\n  gap: 10px;\n  padding: 12px 14px;\n  border-radius: 14px;\n  background: color-mix(in srgb, var(--m3d-warning) 14%, transparent);\n  color: var(--m3d-text);\n  font-size: 14px;\n}\n.scallout svg {\n  flex: none;\n  color: var(--m3d-warning);\n}\n\n@media (max-width: 1100px) {\n  .stile--4,\n.stile--6,\n.stile--8 {\n    grid-column: span 12;\n  }\n}\n/*\n * The Library's look (KAN-521, the Library screens of 12 Oct): its buttons,\n * chips, pills, picture stage, cards and printer rows, shared by the Library\n * page, a print's page, Print on… and Settings › Library. Global, because\n * the dialogs mount outside the page. Colours come from the --m3d-* tokens\n * only, so both themes and both page styles follow.\n */\n.lib-btn {\n  display: inline-flex;\n  flex: none;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  height: 38px;\n  padding: 0 16px;\n  border: 1px solid var(--m3d-border);\n  border-radius: 999px;\n  background: var(--m3d-surface-2);\n  color: var(--m3d-text) !important;\n  font-size: 13.5px;\n  font-weight: 600;\n  text-decoration: none;\n  white-space: nowrap;\n  cursor: pointer;\n}\n.lib-btn:hover:not(:disabled) {\n  filter: brightness(1.12);\n}\n.lib-btn:disabled {\n  opacity: 0.45;\n  cursor: default;\n}\n\n.lib-btn--sm {\n  height: 30px;\n  padding: 0 12px;\n  font-size: 12.5px;\n}\n\n.lib-btn--lg {\n  height: 46px;\n  padding: 0 22px;\n  font-size: 15px;\n}\n\n.lib-btn--pri {\n  border-color: transparent;