{"type":"frame-snapshot","snapshot":{"callId":"oskl@67","phase":"after","pageId":"page@e4c821173a41c63704a4058a7c822c04","frameId":"frame@99e97172899cec79e8c6dbd3ec655ac0","frameUrl":"http://localhost:4291/boxwood-367a","doctype":"html","html":["HTML",{"lang":"en","data-m3d-style":"glass","data-muon-theme":"dark","class":"muon-font","style":"--m3d-on-accent: #000000;"},["HEAD",{},["BASE",{"href":"http://localhost:4291/boxwood-367a"}],"\n    ","\n\n    ","\n\n    ",["META",{"charset":"utf-8"}],"\n    ",["META",{"http-equiv":"X-UA-Compatible","content":"IE=edge"}],"\n    ",["META",{"name":"viewport","content":"width=device-width,initial-scale=1.0"}],"\n    ","\n    ","\n    ",["STYLE",{},"\n      @font-face {\n        font-family: 'Krona One';\n        font-style: normal;\n        font-weight: 400;\n        font-display: block;\n        src: url('/fonts/krona-one-latin-400-normal.woff2') format('woff2');\n      }\n      /* The glass look from the first frame (KAN-2257): Control's own\n         background, text and system font, so nothing changes colour or\n         typeface when the app takes over. The values are the glass tokens in\n         src/scss/muon3d-glass.scss (--m3d-bg, --m3d-text, --m3d-font-sans). */\n      html, body { margin: 0; background: #000; }\n      html[data-muon-theme=light], html[data-muon-theme=light] body { background: #f2f2f7; }\n\n      #muon-loader {\n        position: fixed; inset: 0; z-index: 9999;\n        display: flex; align-items: center; justify-content: center;\n        background: #000; color: #f5f5f7;\n        font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter Variable', 'Helvetica Neue', Arial, sans-serif;\n        --muon-loader-progress: 0;\n        --muon-loader-accent: #80d6d1;\n        --muon-loader-line: rgb(84 84 88 / 48%);\n        --muon-loader-muted: #98989d;\n      }\n      html[data-muon-theme=light] #muon-loader { background: #f2f2f7; color: #1d1d1f; --muon-loader-accent: #2c8782; --muon-loader-line: rgb(60 60 67 / 13%); --muon-loader-muted: #6e6e73; }\n      /* Leaves in three quarters of a fast step, on the exit curve. */\n      #muon-loader.muon-loader--gone { opacity: 0; transition: opacity 120ms cubic-bezier(0.4, 0, 1, 1); pointer-events: none; }\n\n      /* The bar fills by transform, not width, so it never lays out a frame. */\n      .muon-loader__bar { position: absolute; top: 0; left: 0; right: 0; height: 2px; overflow: hidden; background: color-mix(in srgb, var(--muon-loader-accent) 15%, transparent); }\n      .muon-loader__fill {\n        position: relative; height: 100%; width: 100%; overflow: hidden;\n        background: var(--muon-loader-accent);\n        transform: scaleX(var(--muon-loader-progress)); transform-origin: 0 50%;\n        transition: transform 240ms cubic-bezier(0.2, 0, 0, 1);\n      }\n      .muon-loader__fill::after {\n        content: ''; position: absolute; inset: 0;\n        background: linear-gradient(90deg, transparent 30%, rgb(255 255 255 / 55%) 50%, transparent 70%);\n        animation: muon-loader-sheen 1.4s linear infinite;\n      }\n      @keyframes muon-loader-sheen { from { transform: translateX(-100%); } to { transform: translateX(100%); } }\n      @media (prefers-reduced-motion: reduce) { .muon-loader__fill::after { animation: none; opacity: 0; } .muon-loader__fill { transition: none; } }\n\n      /* The drawn wordmark shows until Krona One can; then the real type does. */\n      .muon-loader__svg { width: 92px; height: 16px; }\n      .muon-loader__span { font-family: 'Krona One'; font-size: 15px; letter-spacing: 0.24em; line-height: 1; visibility: hidden; }\n      html.muon-font .muon-loader__svg { display: none; }\n      html.muon-font .muon-loader__span { visibility: visible; }\n      #muon-loader.muon-loader--cached .muon-loader__word { display: none; }\n\n      .muon-loader__error { position: absolute; bottom: 24px; font: 14px sans-serif; color: inherit; opacity: 0.8; }\n      .muon-loader__error a { color: var(--muon-loader-accent); }\n\n      /* The last-known state, drawn in plain DOM while the socket connects. */\n      .muon-loader__cached { display: none; position: absolute; inset: 0; padding: 56px 20px 20px; overflow: auto; }\n      #muon-loader.muon-loader--cached .muon-loader__cached { display: block; }\n      .muon-loader__cached.muon-stale { filter: grayscale(0.5); opacity: 0.55; user-select: none; }\n      .muon-loader__printers, .muon-loader__status, .muon-loader__connecting { max-width: 520px; margin-left: auto; margin-right: auto; }\n      .muon-loader__printer { display: flex; align-items: center; gap: 12px; padding: 10px 4px; border-bottom: 1px solid var(--muon-loader-line); font-size: 14px; }\n      .muon-loader__printer-name { font-weight: 600; }\n      .muon-loader__printer-detail { margin-left: auto; font-size: 12px; opacity: 0.7; }\n      /* One colour per state, as everywhere else: printing teal, ready green,\n         paused amber, fault red, offline grey. */\n      .muon-loader__pill { padding: 2px 9px; border-radius: 999px; font-size: 11px; font-weight: 600; color: var(--muon-loader-muted); background: color-mix(in srgb, currentColor 15%, transparent); }\n      .muon-loader__pill--printing { color: var(--muon-loader-accent); }\n      .muon-loader__pill--ready { color: rgb(48 209 88); }\n      .muon-loader__pill--paused { color: rgb(255 146 48); }\n      .muon-loader__pill--error { color: rgb(255 66 69); }\n      html[data-muon-theme=light] .muon-loader__pill--ready { color: rgb(0 137 50); }\n      html[data-muon-theme=light] .muon-loader__pill--paused { color: rgb(201 52 0); }\n      html[data-muon-theme=light] .muon-loader__pill--error { color: rgb(215 0 21); }\n      .muon-loader__status-file { font-size: 13px; margin: 16px 0 8px; opacity: 0.9; }\n      .muon-loader__progress { height: 3px; border-radius: 2px; overflow: hidden; background: color-mix(in srgb, var(--muon-loader-accent) 15%, transparent); margin: 8px 0; }\n      .muon-loader__progress-fill { height: 100%; background: var(--muon-loader-accent); transform-origin: 0 50%; }\n      .muon-loader__status-temps { font-size: 13px; opacity: 0.8; margin-top: 12px; }\n      .muon-loader__status-when { font-size: 11px; opacity: 0.6; margin-top: 8px; }\n      .muon-loader__connecting { display: flex; align-items: center; gap: 10px; margin-top: 18px; font-size: 12px; opacity: 0.8; }\n      .muon-loader__connecting-line { position: relative; flex: 1; height: 2px; background: color-mix(in srgb, var(--muon-loader-accent) 15%, transparent); overflow: hidden; }\n      .muon-loader__connecting-line::after { content: ''; position: absolute; top: 0; bottom: 0; left: 0; width: 40%; background: var(--muon-loader-accent); animation: muon-loader-indet 1.2s cubic-bezier(0.2, 0, 0, 1) infinite; }\n      @keyframes muon-loader-indet { from { transform: translateX(-100%); } to { transform: translateX(250%); } }\n      @media (prefers-reduced-motion: reduce) { .muon-loader__connecting-line::after { animation: none; transform: translateX(75%); } }\n    "],"\n    ",["TITLE",{},"Muon3D"],"\n    ",["META",{"name":"description","content":"The Klipper web interface for managing your 3d printer"}],"\n\n    ","\n    ","\n    ","\n    ",["META",{"name":"mobile-web-app-capable","content":"yes"}],"\n    ",["META",{"name":"apple-mobile-web-app-capable","content":"yes"}],"\n    ",["META",{"name":"apple-mobile-web-app-status-bar-style","content":"black"}],"\n    ",["META",{"name":"apple-mobile-web-app-title","content":"Muon3D"}],"\n    ",["LINK",{"rel":"apple-touch-icon","sizes":"180x180","href":"/img/icons/apple-touch-icon-180x180.png"}],"\n    ",["LINK",{"rel":"mask-icon","href":"/img/icons/safari-pinned-tab.svg","color":"#000000"}],"\n    ",["META",{"name":"msapplication-TileImage","content":"/img/icons/mstile-150x150.png"}],"\n    ",["META",{"name":"msapplication-TileColor","content":"#000000"}],"\n\n    ","\n  ",["LINK",{"rel":"manifest","href":"/manifest.webmanifest"}],["STYLE",{},