input::-webkit-inner-spin-button {\n  -webkit-appearance: none;\n  margin: 0;\n}\n\n/* Firefox */\ninput[type=number] {\n  -moz-appearance: textfield;\n}\n\n.v-btn {\n  touch-action: manipulation;\n}\n\n.constrained-width.single {\n  max-width: 892.5px;\n}\n\n.constrained-width.double {\n  max-width: 1785px;\n}\n\n.constrained-width.triple {\n  max-width: 2677.5px;\n}\n\n.constrained-width.quad {\n  max-width: 3570px;\n}\n\n.spool-icon {\n  stroke: rgba(0, 0, 0, 0.25);\n  stroke-width: 0.025rem;\n}\n\n.theme--dark .spool-icon {\n  stroke: rgba(0, 0, 0, 0.5);\n}\n\n.v-application kbd {\n  background: #4A4A4F !important;\n}\n\n.rotate-90 {\n  -webkit-transform: rotate(90deg);\n  -moz-transform: rotate(90deg);\n  -ms-transform: rotate(90deg);\n  -o-transform: rotate(90deg);\n  transform: rotate(90deg);\n}\n\n.rotate-180 {\n  -webkit-transform: rotate(180deg);\n  -moz-transform: rotate(180deg);\n  -ms-transform: rotate(180deg);\n  -o-transform: rotate(180deg);\n  transform: rotate(180deg);\n}\n\n.v-card.collapsable-card .v-card__title.collapsable-card-title {\n  position: relative;\n  z-index: 4;\n  font-size: 1rem;\n  min-height: 36px;\n  padding-top: 0;\n  padding-bottom: 0;\n}\n@media only screen and (min-width: 600px) {\n  .v-card.collapsable-card .v-card__title.collapsable-card-title {\n    font-size: 1.125rem;\n    min-height: 42px;\n  }\n}\n\n.v-card.collapsable-card:not(.collapsed) .v-card__title.collapsable-card-title {\n  box-shadow: 0px 2px 4px -1px rgba(0, 0, 0, 0.2), 0px 4px 5px 0px rgba(0, 0, 0, 0.14), 0px 1px 10px 0px rgba(0, 0, 0, 0.12);\n}\n\n.v-card.collapsable-card .v-card__title.collapsable-card-title .v-tabs {\n  margin-left: -16px;\n}\n.v-card.collapsable-card .v-card__title.collapsable-card-title .v-tabs .v-tabs-bar__content > .v-tab:first-child:before {\n  border-top-left-radius: 4px;\n}\n\n.v-card.collapsable-card .v-toolbar {\n  z-index: 3;\n}\n\n.theme--dark .v-card .v-card__title.collapsable-card-title {\n  border-bottom: thin solid rgba(255, 255, 255, 0.1) !important;\n}\n\n.theme--light .v-card .v-card__title.collapsable-card-title {\n  border-bottom: thin solid rgba(0, 0, 0, 0.1) !important;\n}\n\n.focus--text {\n  font-size: 1.125rem;\n  font-weight: 300 !important;\n  letter-spacing: 0.0125em !important;\n  line-height: auto;\n}\n\n.theme--light .dim--text {\n  color: rgba(0, 0, 0, 0.45);\n}\n\n.theme--dark .dim--text {\n  color: rgba(232, 236, 238, 0.45);\n}\n\n/* Add a class to help us spin an icon if we need.. */\n.spin {\n  animation-name: spin;\n  animation-duration: 1000ms;\n  animation-iteration-count: infinite;\n  animation-timing-function: linear;\n}\n\n.spin-alt {\n  animation-name: spin-alt;\n  animation-duration: 1000ms;\n  animation-iteration-count: infinite;\n  animation-timing-function: linear;\n}\n\n@keyframes spin {\n  from {\n    transform: rotate(0deg);\n  }\n  to {\n    transform: rotate(-360deg);\n  }\n}\n@keyframes spin-alt {\n  from {\n    transform: rotate(-360deg);\n  }\n  to {\n    transform: rotate(0deg);\n  }\n}\n.wiggle {\n  animation-name: wiggle;\n  animation-duration: 5000ms;\n  animation-iteration-count: infinite;\n  animation-timing-function: linear;\n}\n\n/* Notification wiggle */\n@keyframes wiggle {\n  0% {\n    transform: rotate(0deg);\n  }\n  2% {\n    transform: rotate(-15deg);\n  }\n  4% {\n    transform: rotate(15deg);\n  }\n  6% {\n    transform: rotate(-15deg);\n  }\n  8% {\n    transform: rotate(0deg);\n  }\n  100% {\n    transform: rotate(0deg);\n  }\n}\n/* Prevent zoom on mobile devices when furiosly clicking buttons */\nbutton .v-btn {\n  touch-action: manipulation;\n}\n\nbutton .v-icon {\n  touch-action: manipulation;\n}\n\n.v-btn-toggle > .v-btn.v-btn {\n  border-top: 0 !important;\n  border-bottom: 0 !important;\n}\n.v-btn-toggle > .v-btn.v-btn:first-child {\n  border-left: 0 !important;\n}\n.v-btn-toggle > .v-btn.v-btn:last-child {\n  border-right: 0 !important;\n}\n\n.chip-group .v-chip {\n  margin: 2px 2px;\n}\n.chip-group .v-chip:first-child {\n  margin: 0 2px 0 0;\n}\n.chip-group .v-chip:last-child {\n  margin: 0 0 0 2px;\n}\n.chip-group .v-chip:only-child {\n  margin: 0;\n}\n\n/** File system specific tweaks **/\n.file-system tr.row-select td {\n  cursor: pointer;\n  user-select: none;\n}\n.file-system .file-icon-thumb {\n  align-items: center;\n  display: inline-flex;\n  justify-content: center;\n  letter-spacing: normal;\n  line-height: 1;\n  position: relative;\n  vertical-align: middle;\n  pointer-events: none;\n}\n.file-system .v-data-table > .v-data-table__wrapper > table > tbody > tr > td,\n.file-system .v-data-table > .v-data-table__wrapper > table > tbody > tr > th,\n.file-system .v-data-table > .v-data-table__wrapper > table > thead > tr > td,\n.file-system .v-data-table > .v-data-table__wrapper > table > thead > tr > th,\n.file-system .v-data-table > .v-data-table__wrapper > table > tfoot > tr > td,\n.file-system .v-data-table > .v-data-table__wrapper > table > tfoot > tr > th {\n  padding-right: 12px;\n  padding-left: 12px;\n}\n.file-system .v-data-table > .v-data-table__wrapper > table > tbody > tr > td:first-child,\n.file-system .v-data-table > .v-data-table__wrapper > table > tbody > tr > th:first-child,\n.file-system .v-data-table > .v-data-table__wrapper > table > thead > tr > td:first-child,\n.file-system .v-data-table > .v-data-table__wrapper > table > thead > tr > th:first-child,\n.file-system .v-data-table > .v-data-table__wrapper > table > tfoot > tr > td:first-child,\n.file-system .v-data-table > .v-data-table__wrapper > table > tfoot > tr > th:first-child {\n  padding-left: 12px;\n  padding-right: 0;\n}\n.file-system .v-data-table > .v-data-table__wrapper > table > thead > tr > th {\n  white-space: nowrap;\n}\n.file-system .v-data-table__expanded.v-data-table__expanded__row > td {\n  border-bottom: none !important;\n}\n.file-system .v-data-table__expanded.v-data-table__expanded__content {\n  box-shadow: none !important;\n}\n.file-system .theme--light.v-data-table tr > td.actions div {\n  background: #eeeeee;\n}\n.file-system .theme--light.v-data-table tr > td.actions div:before {\n  background: linear-gradient(90deg, rgba(238, 238, 238, 0) 0%, #eeeeee 100%);\n}\n.file-system .theme--dark.v-data-table tr > td.actions div {\n  background: #212629;\n}\n.file-system .theme--dark.v-data-table tr > td.actions div:before {\n  background: linear-gradient(90deg, rgba(33, 38, 41, 0) 0%, #212629 100%);\n}\n.file-system .v-data-table tr > td.actions {\n  position: relative;\n  width: 0px;\n  right: 0;\n  padding: 0 !important;\n  display: none;\n  border-bottom: none !important;\n}\n.file-system .v-data-table tr > td.actions div {\n  position: absolute;\n  display: flex;\n  top: 0;\n  right: 0;\n  align-items: center;\n  padding: 0 12px;\n  vertical-align: middle;\n  height: calc(100% - 1px);\n  border: none;\n}\n.file-system .v-data-table tr > td.actions div:before {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  left: -32px;\n  width: 32px;\n  height: inherit;\n}\n.file-system .v-data-table tr:hover > td.actions {\n  display: table-cell;\n}\n\n.theme--light.bulk-drag {\n  color: #000000;\n  background-color: whitesmoke;\n}\n\n.theme--dark.bulk-drag {\n  color: #e8ecee;\n  background-color: #212629;\n}\n\n.bulk-drag {\n  font-family: var(--m3d-font-sans);\n  line-height: 1.5;\n  display: flex;\n  flex: 1 1 auto;\n  position: absolute;\n  top: -1000px;\n  right: 0;\n  width: auto;\n  min-width: 170px;\n  height: 40px;\n  align-items: center;\n  padding: 0 16px 0 32px;\n  border-radius: 6px;\n  text-wrap: nowrap;\n}\n\n/**\n * The file manager in the redesign's colours: Fluidd's table, toolbar,\n * breadcrumbs and menus, drawn with the --m3d tokens so both themes follow.\n */\n.filesystem-wrapper.v-card {\n  border: 1px solid var(--m3d-border);\n  border-radius: 16px !important;\n  background: var(--m3d-surface) !important;\n  color: var(--m3d-text);\n}\n.filesystem-wrapper.v-card .v-toolbar {\n  background: var(--m3d-surface) !important;\n  border-bottom: 1px solid var(--m3d-border);\n  box-shadow: none !important;\n}\n.filesystem-wrapper.v-card .v-toolbar .v-tab {\n  color: var(--m3d-text-muted);\n  font-weight: 600;\n  letter-spacing: 0;\n  text-transform: none;\n}\n.filesystem-wrapper.v-card .file-crumbs {\n  display: flex;\n  align-items: center;\n  font-family: var(--m3d-font-mono, monospace);\n  font-size: 13px;\n}\n.filesystem-wrapper.v-card .file-crumbs .file-crumbs__crumb {\n  padding: 2px 4px;\n  border-radius: var(--m3d-radius-sm);\n  color: var(--m3d-accent);\n}\n.filesystem-wrapper.v-card .file-crumbs .file-crumbs__crumb:hover:not(:disabled) {\n  background: var(--m3d-accent-soft);\n}\n.filesystem-wrapper.v-card .file-crumbs .file-crumbs__crumb:disabled {\n  color: var(--m3d-text);\n  cursor: default;\n  font-weight: 600;\n}\n.filesystem-wrapper.v-card .file-crumbs .file-crumbs__sep {\n  color: var(--m3d-text-subtle);\n}\n.filesystem-wrapper.v-card .file-system .v-data-table {\n  background: transparent !important;\n}\n.filesystem-wrapper.v-card .file-system .v-data-table .v-data-table__wrapper {\n  scrollbar-gutter: stable;\n}\n.filesystem-wrapper.v-card .file-system .v-data-table th {\n  background: var(--m3d-surface-2) !important;\n  border-bottom: 1px solid var(--m3d-border) !important;\n  color: var(--m3d-text-muted) !important;\n  font-size: 12px !important;\n  font-weight: 600;\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n}\n.filesystem-wrapper.v-card .file-system .v-data-table td {\n  border-bottom: 1px solid var(--m3d-border) !important;\n  color: var(--m3d-text);\n}\n.filesystem-wrapper.v-card .file-system .v-data-table tr.row-select {\n  transition: background var(--m3d-duration-fast) var(--m3d-ease);\n}\n.filesystem-wrapper.v-card .file-system .v-data-table tr.row-select:hover {\n  background: var(--m3d-hover) !important;\n}\n.filesystem-wrapper.v-card .file-system .v-data-table tr.row-select.v-data-table__selected {\n  background: var(--m3d-accent-soft) !important;\n}\n.filesystem-wrapper.v-card .file-system .v-data-table tr.row-select.active {\n  outline: 2px dashed var(--m3d-accent-line);\n  outline-offset: -2px;\n}\n.filesystem-wrapper.v-card .file-system .v-data-table tr.fs-pad td {\n  padding: 0;\n  border: 0 !important;\n}\n.filesystem-wrapper.v-card .file-system .v-data-table td.fs-cell {\n  color: var(--m3d-text-muted);\n  font-family: var(--m3d-font-mono, monospace);\n  font-size: 13px;\n  white-space: nowrap;\n}\n.filesystem-wrapper.v-card .file-system .v-data-table td.fs-name {\n  font-weight: 500;\n  max-width: 0;\n  min-width: 160px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.filesystem-wrapper.v-card .file-system .v-data-table td.fs-more {\n  padding-left: 0 !important;\n  text-align: right;\n}\n.filesystem-wrapper.v-card .file-system .v-data-table .fs-more__btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 32px;\n  height: 32px;\n  border-radius: 999px;\n  color: var(--m3d-text-muted);\n}\n.filesystem-wrapper.v-card .file-system .v-data-table .fs-more__btn:hover:not(:disabled) {\n  background: var(--m3d-surface-2);\n  color: var(--m3d-text);\n}\n.filesystem-wrapper.v-card .file-system .v-data-table .fs-more__btn:focus-visible {\n  outline: 2px solid var(--m3d-accent);\n}\n\n/* Extra dense text inputs */\n.v-input--text-right input {\n  text-align: right;\n}\n\n.v-input--width-x-small {\n  width: 100px;\n}\n\n.v-input--width-small {\n  width: 140px;\n}\n\n.v-input--width-medium {\n  width: 180px;\n}\n\n.v-input--x-dense .v-input__slot {\n  min-height: 25px !important;\n}\n\n.v-input--dense .v-input__slot {\n  min-height: 36px !important;\n}\n\n.v-input--x-dense .v-select__selections {\n  padding: 2px 0 !important;\n}\n\n.v-input--x-dense .v-input__append-inner {\n  margin-top: 6px !important;\n}\n\n.v-text-field.v-text-field--solo .v-input__control {\n  min-height: 10px;\n}\n\n.v-input--dense .v-text-field--box .v-input__slot, .v-text-field--outline .v-input__slot {\n  min-height: 30px !important;\n}\n\n/* Extra dense list items */\n.v-list-item--x-dense .v-list-item__content,\n.v-list--x-dense .v-list-item .v-list-item__content {\n  padding: 6px 0 !important;\n}\n\n.v-list-item--x-dense .v-list-item__action,\n.v-list--x-dense .v-list-item .v-list-item__action {\n  margin: 8px 0;\n}\n\n/* Helps alignment for some outer buttons */\n.v-text-field-outer-btn .v-input__control {\n  min-height: 36px !important;\n}\n.v-text-field-outer-btn .v-input__prepend-outer, .v-text-field-outer-btn .v-input__append-outer {\n  margin-top: 0px !important;\n  margin-bottom: 0 !important;\n}\n\n.theme--light.v-list-item--disabled .v-list-item__icon .v-icon {\n  color: rgba(0, 0, 0, 0.38) !important;\n}\n\n.theme--dark.v-list-item--disabled .v-list-item__icon .v-icon {\n  color: rgba(255, 255, 255, 0.5) !important;\n}\n\n.theme--light.v-data-table.no-hover > .v-data-table__wrapper > table > tbody > tr:hover:not(.v-data-table__expanded__content):not(.v-data-table__empty-wrapper),\n.theme--dark.v-data-table.no-hover > .v-data-table__wrapper > table > tbody > tr:hover:not(.v-data-table__expanded__content):not(.v-data-table__empty-wrapper) {\n  background-color: transparent;\n}\n\n.v-data-table__wrapper > table > tbody > tr.v-data-table__inactive {\n  color: var(--v-secondary-base);\n}\n\n/*\n * Muon3D design layer for Fluidd (Vuetify 2).\n *\n * Rules this file keeps, so the next change does not reintroduce the defects\n * it replaced:\n *\n *  - Structure comes from 1px hairlines, not shadows. Only things that float\n *    (menus, dialogs, tooltips, snackbars) get a shadow.\n *  - Three radii only: --m3d-radius-sm for controls, --m3d-radius-md for\n *    cards/menus/dialogs, and 0. Anything painted inside a rounded container\n *    either shares its background or inherits its corner, so no corner or\n *    shadow can poke past the edge it sits in.\n *  - The accent is the theme's primary colour (--v-primary-base), never a\n *    fixed teal, so the theme picker in Settings recolours everything.\n *  - Never force an overlay scrim opaque: Vuetify keeps inactive overlays in\n *    the DOM at opacity 0, and forcing it blacks out the whole app.\n */\n@font-face {\n  font-family: \"Krona One\";\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"/fonts/krona-one-latin-400-normal.woff2\") format(\"woff2\");\n}\n:root {\n  --m3d-font-display: \"Krona One\", \"IBM Plex Sans\", sans-serif;\n  --m3d-font-sans: \"IBM Plex Sans\", \"Helvetica Neue\", Arial, sans-serif;\n  --m3d-font-mono: \"IBM Plex Mono\", ui-monospace, \"SFMono-Regular\", Consolas, monospace;\n  --m3d-radius-sm: 4px;\n  --m3d-radius-md: 6px;\n  --m3d-radius-pill: 999px;\n  --m3d-duration-fast: var(--m3d-motion-fast);\n  --m3d-duration-base: var(--m3d-motion-base);\n  --m3d-ease: var(--m3d-ease-standard);\n  --m3d-motion-instant: 80ms;\n  --m3d-motion-fast: 160ms;\n  --m3d-motion-base: 240ms;\n  --m3d-motion-slow: 340ms;\n  --m3d-motion-slower: 520ms;\n  --m3d-motion-camera: 800ms;\n  --m3d-motion-stagger: 40ms;\n  --m3d-motion-press-scale: 0.95;\n  --m3d-motion-press-in: 80ms;\n  --m3d-motion-press-out: 320ms;\n  --m3d-ease-standard: cubic-bezier(0.2, 0, 0, 1);\n  --m3d-ease-enter: cubic-bezier(0.16, 1, 0.3, 1);\n  --m3d-ease-exit: cubic-bezier(0.4, 0, 1, 1);\n  --m3d-spring-snappy: linear(0, 0.0202, 0.0703, 0.1378, 0.2142, 0.2934, 0.3715, 0.4459, 0.5151, 0.5783, 0.6352, 0.686, 0.7308, 0.77, 0.8041, 0.8337, 0.8592, 0.881, 0.8997, 0.9156, 0.9291, 0.9405, 0.9502, 0.9584, 0.9652, 0.971, 0.9759, 0.9799, 0.9833, 0.9861, 0.9885, 0.9905, 1);\n  --m3d-spring-snappy-duration: 303ms;\n  --m3d-spring-gentle: linear(0, 0.0315, 0.1089, 0.2115, 0.3245, 0.4376, 0.544, 0.64, 0.7235, 0.7939, 0.8518, 0.8981, 0.9341, 0.9614, 0.9814, 0.9955, 1.0049, 1.0107, 1.0138, 1.0151, 1.015, 1.014, 1.0126, 1.0109, 1.0092, 1.0076, 1.006, 1.0047, 1.0035, 1.0026, 1.0018, 1.0012, 1);\n  --m3d-spring-gentle-duration: 536ms;\n  --m3d-spring-bouncy: linear(0, 0.0662, 0.2245, 0.4231, 0.6233, 0.7999, 0.9392, 1.0372, 1.0963, 1.1227, 1.1247, 1.1106, 1.0878, 1.0622, 1.0378, 1.0173, 1.0019, 0.9916, 0.986, 0.9841, 0.9848, 0.9871, 0.9902, 0.9935, 0.9964, 0.9987, 1.0004, 1.0014, 1.0019, 1.002, 1.0018, 1.0015, 1);\n  --m3d-spring-bouncy-duration: 725ms;\n  --m3d-accent: var(--v-primary-base, #80d6d1);\n  --m3d-accent-soft: color-mix(in srgb, var(--m3d-accent) 14%, transparent);\n  --m3d-accent-line: color-mix(in srgb, var(--m3d-accent) 45%, transparent);\n}\n\n:root,\n.v-application.theme--dark {\n  --m3d-bg: #13171a;\n  --m3d-surface: #1a1f22;\n  --m3d-surface-2: #212629;\n  --m3d-inset: #101315;\n  --m3d-raised: #222729;\n  --m3d-border: #2c3337;\n  --m3d-border-strong: #3d464b;\n  --m3d-text: #e8ecee;\n  --m3d-text-muted: #9ea8ae;\n  --m3d-text-subtle: #6f7a80;\n  --m3d-hover: rgb(255 255 255 / 5%);\n  --m3d-success: #5cc98f;\n  --m3d-warning: #e8b04b;\n  --m3d-danger: #f06b61;\n  --m3d-overlay: #050708;\n  --m3d-shadow-float: 0 8px 24px rgb(0 0 0 / 45%), 0 1px 2px rgb(0 0 0 / 40%);\n  /* The live M1's stage, middle out: a dim studio, so the white machine stands out without glaring. */\n  --m3d-stage-hi: #3a4247;\n  --m3d-stage-mid: #283034;\n  --m3d-stage-lo: #1b2023;\n}\n\n.v-application.theme--light {\n  --m3d-bg: #f1f3f4;\n  --m3d-surface: #ffffff;\n  --m3d-surface-2: #f6f8f9;\n  --m3d-inset: #f1f3f4;\n  --m3d-raised: #ffffff;\n  --m3d-border: #dce1e4;\n  --m3d-border-strong: #c2c9cd;\n  --m3d-text: #121719;\n  --m3d-text-muted: #56626a;\n  --m3d-text-subtle: #87929a;\n  --m3d-hover: rgb(0 0 0 / 4%);\n  --m3d-success: #2c8657;\n  --m3d-warning: #a8761e;\n  --m3d-danger: #c23b32;\n  --m3d-overlay: #121719;\n  --m3d-shadow-float: 0 8px 24px rgb(18 23 25 / 14%), 0 1px 2px rgb(18 23 25 / 8%);\n  --m3d-stage-hi: #eceef0;\n  --m3d-stage-mid: #d8dbdf;\n  --m3d-stage-lo: #c4c8cd;\n}\n\n/*\n * Scale tokens and aliases used by the Login and managed-preview views. The\n * old radius and elevation names resolve to the new, flatter values so those\n * views follow this system instead of keeping 28px corners.\n */\n:root,\n.v-application {\n  --m3d-text-2xs: 0.6875rem;\n  --m3d-text-xs: 0.75rem;\n  --m3d-text-sm: 0.875rem;\n  --m3d-text-md: 1rem;\n  --m3d-text-lg: 1.125rem;\n  --m3d-text-xl: 1.375rem;\n  --m3d-text-2xl: 1.75rem;\n  --m3d-text-3xl: 2.25rem;\n  --m3d-weight-regular: 400;\n  --m3d-weight-medium: 500;\n  --m3d-weight-semibold: 600;\n  --m3d-weight-bold: 600;\n  --m3d-leading-tight: 1.1;\n  --m3d-leading-snug: 1.25;\n  --m3d-leading-normal: 1.5;\n  --m3d-leading-relaxed: 1.6;\n  --m3d-tracking-caps: 0.06em;\n  --m3d-tracking-eyebrow: 0.1em;\n  --m3d-space-1: 0.25rem;\n  --m3d-space-2: 0.5rem;\n  --m3d-space-3: 0.75rem;\n  --m3d-space-4: 1rem;\n  --m3d-space-5: 1.25rem;\n  --m3d-space-6: 1.5rem;\n  --m3d-space-8: 2rem;\n  --m3d-space-10: 2.5rem;\n  --m3d-space-16: 4rem;\n  --m3d-radius-lg: var(--m3d-radius-md);\n  --m3d-radius-xl: var(--m3d-radius-md);\n  --m3d-radius-2xl: var(--m3d-radius-md);\n  --m3d-surface-1: var(--m3d-surface);\n  --m3d-surface-raised: var(--m3d-raised);\n  --m3d-accent-border: var(--m3d-accent-line);\n  --m3d-shadow-sm: none;\n  --m3d-shadow-lg: var(--m3d-shadow-float);\n}\n\n/* ---------------------------------------------------------------- base -- */\nhtml,\nbody {\n  background-color: var(--m3d-bg);\n}\n\n.v-application.fluidd,\n.v-application.fluidd .v-application--wrap {\n  background-color: var(--m3d-bg) !important;\n}\n\n.v-application {\n  font-family: var(--m3d-font-sans) !important;\n  color: var(--m3d-text);\n  font-variant-numeric: tabular-nums;\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n}\n.v-application [class*=text-] {\n  font-family: var(--m3d-font-sans) !important;\n}\n.v-application code,\n.v-application pre,\n.v-application kbd,\n.v-application blockquote,\n.v-application .console-text {\n  font-family: var(--m3d-font-mono) !important;\n}\n.v-application kbd {\n  background: var(--m3d-surface-2) !important;\n  color: var(--m3d-text) !important;\n  border: 1px solid var(--m3d-border-strong);\n  border-radius: 3px;\n  box-shadow: none;\n  padding: 0 5px;\n  font-size: 0.75rem;\n}\n.v-application a {\n  color: var(--m3d-accent);\n}\n.v-application :focus-visible {\n  outline: 2px solid var(--m3d-accent);\n  outline-offset: 1px;\n}\n.v-application .secondary--text,\n.v-application .text--secondary,\n.v-application .dim--text {\n  color: var(--m3d-text-muted) !important;\n}\n.v-application .text--disabled {\n  color: var(--m3d-text-subtle) !important;\n}\n.v-application .focus--text {\n  font-weight: 400 !important;\n}\n\n.v-application .font-weight-light {\n  font-weight: 400 !important;\n}\n\n/* ------------------------------------------------------------- surfaces -- */\n.v-application .v-sheet,\n.v-application .v-card {\n  color: var(--m3d-text);\n}\n\n.v-card {\n  background-color: var(--m3d-surface) !important;\n  border: 1px solid var(--m3d-border) !important;\n  border-radius: var(--m3d-radius-md) !important;\n  box-shadow: none !important;\n}\n\n/* A card inside a card is a region of its parent, not a second box. */\n.v-card .v-card:not(.v-card--outlined) {\n  border: 0 !important;\n  border-radius: 0 !important;\n  background-color: transparent !important;\n}\n\n.v-card > .v-card__title,\n.v-card > .v-card__subtitle,\n.v-card > .v-card__text,\n.v-card > .v-card__actions {\n  padding-left: 16px;\n  padding-right: 16px;\n}\n\n/* A header strip shares the card's corners, so it can never overhang them. */\n.v-card > .v-card__title:first-child,\n.v-card > .v-toolbar:first-child,\n.v-card > .v-card__progress + .v-card__title {\n  border-top-left-radius: inherit;\n  border-top-right-radius: inherit;\n}\n\n.v-card > .v-toolbar:last-child,\n.v-card > .v-card__actions:last-child {\n  border-bottom-left-radius: inherit;\n  border-bottom-right-radius: inherit;\n}\n\n.v-card__title {\n  font-size: 0.9375rem;\n  font-weight: 600;\n  letter-spacing: 0;\n  line-height: 1.3;\n}\n\n.v-card__subtitle {\n  color: var(--m3d-text-muted) !important;\n}\n\n.v-application .card-heading {\n  background-color: var(--m3d-surface) !important;\n}\n\n/* Collapsable (dashboard) cards: a flat 44px header over a hairline. */\n.v-card.collapsable-card .v-card__title.collapsable-card-title {\n  min-height: 44px;\n  padding-top: 0;\n  padding-bottom: 0;\n  font-size: 0.8125rem;\n  font-weight: 600;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n  box-shadow: none !important;\n  border-bottom: 1px solid var(--m3d-border) !important;\n  background-color: var(--m3d-surface) !important;\n}\n.v-card.collapsable-card .v-card__title.collapsable-card-title > .row > .col:first-child > .v-icon {\n  color: var(--m3d-text-subtle) !important;\n  font-size: 18px !important;\n  margin-right: 10px !important;\n}\n.v-card.collapsable-card .v-card__title.collapsable-card-title .v-tabs {\n  margin-left: -16px;\n}\n.v-card.collapsable-card .v-card__title.collapsable-card-title .v-btn:not(.v-btn--icon):not(.v-btn--fab) {\n  letter-spacing: 0.04em;\n}\n\n.v-card.collapsable-card.collapsed .v-card__title.collapsable-card-title,\n.v-card.collapsable-card .v-card__title.collapsable-card-title:last-child {\n  border-bottom-color: transparent !important;\n  border-radius: inherit;\n}\n\n/* Menus, dialogs, tooltips: the only raised things, so the only shadows. */\n.v-menu__content,\n.v-autocomplete__content {\n  background-color: var(--m3d-raised) !important;\n  border: 1px solid var(--m3d-border-strong);\n  border-radius: var(--m3d-radius-md) !important;\n  box-shadow: var(--m3d-shadow-float) !important;\n}\n.v-menu__content > .v-card,\n.v-menu__content > .v-list,\n.v-menu__content > .v-sheet,\n.v-autocomplete__content > .v-card,\n.v-autocomplete__content > .v-list,\n.v-autocomplete__content > .v-sheet {\n  background-color: var(--m3d-raised) !important;\n  border: 0 !important;\n  border-radius: inherit !important;\n}\n\n.v-dialog {\n  border-radius: var(--m3d-radius-md) !important;\n  box-shadow: var(--m3d-shadow-float) !important;\n}\n.v-dialog > .v-card {\n  background-color: var(--m3d-raised) !important;\n  border-color: var(--m3d-border-strong) !important;\n}\n\n.v-dialog.v-dialog--fullscreen {\n  border-radius: 0 !important;\n}\n.v-dialog.v-dialog--fullscreen > .v-card {\n  border: 0 !important;\n  border-radius: 0 !important;\n}\n\n.v-overlay__scrim {\n  background-color: var(--m3d-overlay) !important;\n  border-color: var(--m3d-overlay) !important;\n}\n\n.v-tooltip__content {\n  background: var(--m3d-text) !important;\n  color: var(--m3d-bg) !important;\n  border-radius: var(--m3d-radius-sm) !important;\n  font-size: 0.75rem !important;\n  font-weight: 500;\n  padding: 5px 8px !important;\n  box-shadow: var(--m3d-shadow-float);\n  opacity: 1 !important;\n}\n\n.v-snack__wrapper {\n  background-color: var(--m3d-raised) !important;\n  color: var(--m3d-text) !important;\n  border: 1px solid var(--m3d-border-strong);\n  border-radius: var(--m3d-radius-md) !important;\n  box-shadow: var(--m3d-shadow-float) !important;\n}\n\n/* --------------------------------------------------------------- chrome -- */\n.v-app-bar.v-toolbar,\n.v-navigation-drawer {\n  background-color: var(--m3d-surface) !important;\n  color: var(--m3d-text) !important;\n  box-shadow: none !important;\n}\n\n.v-navigation-drawer__border {\n  background-color: var(--m3d-border) !important;\n}\n\n.v-toolbar {\n  box-shadow: none !important;\n}\n\n.v-divider {\n  border-color: var(--m3d-border) !important;\n}\n\n/* ---------------------------------------------------------------- lists -- */\n.v-list {\n  background-color: transparent !important;\n  padding-top: 4px;\n  padding-bottom: 4px;\n}\n\n.v-menu__content .v-list {\n  padding: 4px;\n}\n\n.v-list-item {\n  color: var(--m3d-text) !important;\n  border-radius: var(--m3d-radius-sm);\n  min-height: 36px;\n}\n.v-list-item::before {\n  background-color: var(--m3d-text);\n  border-radius: inherit;\n}\n.v-list-item:hover::before {\n  opacity: 0.05;\n}\n\n.v-list-item--active {\n  color: var(--m3d-text) !important;\n}\n.v-list-item--active::before {\n  background-color: var(--m3d-accent) !important;\n  opacity: 0.12 !important;\n}\n\n.v-list-item__subtitle,\n.v-list-item__action-text {\n  color: var(--m3d-text-muted) !important;\n}\n\n.v-list-item .v-list-item__icon > .v-icon,\n.v-list-item .v-list-item__action > .v-icon {\n  color: var(--m3d-text-muted);\n}\n\n.v-subheader {\n  color: var(--m3d-text-subtle) !important;\n  font-size: 0.6875rem;\n  font-weight: 600;\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n  height: 32px;\n}\n\n.muon-wordmark {\n  font-family: var(--m3d-font-display);\n  font-size: 0.9375rem;\n  letter-spacing: 0.22em;\n  line-height: 1;\n  color: var(--m3d-text);\n}\n\n/* -------------------------------------------------------------- buttons -- */\n.v-btn {\n  border-radius: var(--m3d-radius-sm) !important;\n  box-shadow: none !important;\n  font-family: var(--m3d-font-sans) !important;\n  font-weight: 600;\n  letter-spacing: 0.05em;\n  transition: background-color var(--m3d-duration-fast) var(--m3d-ease), border-color var(--m3d-duration-fast) var(--m3d-ease), color var(--m3d-duration-fast) var(--m3d-ease) !important;\n}\n.v-btn:not(.v-btn--icon):not(.v-btn--fab) {\n  font-size: 0.75rem;\n}\n.v-btn.v-size--small:not(.v-btn--icon):not(.v-btn--fab) {\n  font-size: 0.6875rem;\n}\n.v-btn.v-size--x-small:not(.v-btn--icon):not(.v-btn--fab) {\n  font-size: 0.625rem;\n}\n.v-btn::before {\n  border-radius: inherit;\n}\n.v-btn:hover::before {\n  opacity: 0.08;\n}\n\n.v-btn.v-btn--fab,\n.v-btn.v-btn--icon,\n.v-btn.v-btn--round {\n  border-radius: var(--m3d-radius-sm) !important;\n}\n\n/* Default (btncolor) buttons are quiet: a surface tile with a hairline. */\n.v-btn.btncolor {\n  background-color: var(--m3d-surface-2) !important;\n  border: 1px solid var(--m3d-border) !important;\n  color: var(--m3d-text) !important;\n}\n.v-btn.btncolor:hover {\n  border-color: var(--m3d-border-strong) !important;\n}\n\n.v-btn.transparent,\n.v-btn.bg-transparent {\n  border: 0 !important;\n}\n\n.v-btn.v-btn--outlined {\n  border-color: var(--m3d-border-strong) !important;\n}\n.v-btn.v-btn--outlined:not(.primary--text):not(.error--text):not(.warning--text):not(.success--text) {\n  color: var(--m3d-text) !important;\n}\n\n.v-btn.v-btn--disabled:not(.v-btn--text):not(.v-btn--icon):not(.v-btn--outlined):not(.transparent) {\n  background-color: var(--m3d-surface-2) !important;\n  border: 1px solid var(--m3d-border);\n}\n\n.v-btn.v-btn--disabled,\n.v-btn.v-btn--disabled .v-icon {\n  color: var(--m3d-text-subtle) !important;\n}\n\n.v-btn-toggle {\n  border: 1px solid var(--m3d-border) !important;\n  border-radius: var(--m3d-radius-sm) !important;\n  background: var(--m3d-inset) !important;\n  overflow: hidden;\n}\n.v-btn-toggle > .v-btn.v-btn {\n  border: 0 !important;\n  border-radius: 0 !important;\n  background-color: transparent !important;\n  opacity: 1;\n}\n.v-btn-toggle > .v-btn.v-btn + .v-btn {\n  border-left: 1px solid var(--m3d-border) !important;\n}\n.v-btn-toggle > .v-btn.v-btn--active {\n  background-color: var(--m3d-accent-soft) !important;\n  color: var(--m3d-accent) !important;\n}\n\n/* --------------------------------------------------------------- chips --- */\n.v-chip {\n  border-radius: var(--m3d-radius-sm) !important;\n  font-weight: 500;\n  letter-spacing: 0.02em;\n}\n.v-chip.v-chip--outlined {\n  border-color: var(--m3d-border-strong) !important;\n}\n.v-chip:not(.v-chip--outlined):not([class*=\"--text\"]):not(.primary):not(.error):not(.warning):not(.success):not(.info) {\n  background-color: var(--m3d-surface-2) !important;\n  border: 1px solid var(--m3d-border);\n  color: var(--m3d-text) !important;\n}\n\n/* --------------------------------------------------------------- inputs -- */\n.v-input {\n  font-size: 0.875rem;\n}\n\n.v-input input,\n.v-input textarea,\n.v-select__selection {\n  color: var(--m3d-text) !important;\n}\n\n.v-input input::placeholder,\n.v-input textarea::placeholder {\n  color: var(--m3d-text-subtle) !important;\n  opacity: 1;\n}\n\n.v-label {\n  color: var(--m3d-text-muted) !important;\n}\n\n.v-text-field--outlined,\n.v-text-field--filled,\n.v-text-field--solo {\n  border-radius: var(--m3d-radius-sm) !important;\n}\n\n.v-text-field--filled > .v-input__control > .v-input__slot,\n.v-text-field--solo > .v-input__control > .v-input__slot,\n.v-text-field--outlined > .v-input__control > .v-input__slot {\n  background-color: var(--m3d-inset) !important;\n  border-radius: var(--m3d-radius-sm) !important;\n  box-shadow: none !important;\n}\n\n.v-text-field--filled > .v-input__control > .v-input__slot,\n.v-text-field--solo > .v-input__control > .v-input__slot {\n  box-shadow: inset 0 0 0 1px var(--m3d-border) !important;\n}\n\n.v-text-field--filled.v-input--is-focused > .v-input__control > .v-input__slot,\n.v-text-field--solo.v-input--is-focused > .v-input__control > .v-input__slot {\n  box-shadow: inset 0 0 0 1px var(--m3d-accent) !important;\n}\n\n/* Filled fields draw their own underline; the inset border replaces it. */\n.v-text-field--filled > .v-input__control > .v-input__slot::before,\n.v-text-field--filled > .v-input__control > .v-input__slot::after {\n  display: none;\n}\n\n.v-text-field--outlined fieldset {\n  border: 1px solid var(--m3d-border) !important;\n  border-radius: var(--m3d-radius-sm) !important;\n}\n\n.v-text-field--outlined:not(.v-input--is-focused):not(.v-input--has-state) > .v-input__control > .v-input__slot:hover fieldset {\n  border-color: var(--m3d-border-strong) !important;\n}\n\n.v-text-field--outlined.v-input--is-focused fieldset {\n  border-color: var(--m3d-accent) !important;\n}\n\n.v-text-field:not(.v-text-field--outlined):not(.v-text-field--filled):not(.v-text-field--solo) > .v-input__control > .v-input__slot::before {\n  border-color: var(--m3d-border-strong) !important;\n}\n\n.v-input--is-focused .v-label {\n  color: var(--m3d-accent) !important;\n}\n\n.v-input--has-state.error--text fieldset,\n.v-input--has-state.error--text .v-label {\n  border-color: var(--m3d-danger) !important;\n  color: var(--m3d-danger) !important;\n}\n\n.v-input--is-disabled {\n  opacity: 0.55;\n}\n\n.v-input--selection-controls .v-input--selection-controls__ripple {\n  border-radius: var(--m3d-radius-sm);\n}\n\n.v-input--switch .v-input--switch__track {\n  border-radius: var(--m3d-radius-pill);\n  opacity: 1;\n  background-color: var(--m3d-border-strong);\n  color: var(--m3d-border-strong) !important;\n}\n.v-input--switch .v-input--switch__thumb {\n  color: var(--m3d-text-muted) !important;\n  box-shadow: none;\n}\n.v-input--switch.v-input--is-label-active .v-input--switch__track,\n.v-input--switch .v-input--is-label-active .v-input--switch__track {\n  background-color: var(--m3d-accent-line);\n  color: var(--m3d-accent) !important;\n}\n.v-input--switch.v-input--is-label-active .v-input--switch__thumb {\n  color: var(--m3d-accent) !important;\n}\n\n.v-slider__track-background {\n  background-color: var(--m3d-border-strong) !important;\n  border-color: var(--m3d-border-strong) !important;\n  opacity: 1;\n}\n\n.v-slider__thumb {\n  box-shadow: 0 0 0 3px var(--m3d-surface);\n}\n\n/* ----------------------------------------------------------------- tabs -- */\n.v-tabs-bar {\n  background-color: transparent !important;\n}\n\n.v-tab {\n  color: var(--m3d-text-muted) !important;\n  font-size: 0.75rem !important;\n  font-weight: 600;\n  letter-spacing: 0.06em;\n  min-width: 72px;\n}\n\n.v-tab--active {\n  color: var(--m3d-text) !important;\n}\n\n.v-tabs-slider {\n  background-color: var(--m3d-accent) !important;\n}\n\n.v-tabs-items {\n  background-color: transparent !important;\n}\n\n/* --------------------------------------------------------------- tables -- */\n.v-data-table {\n  background-color: transparent !important;\n  border-radius: 0;\n  color: var(--m3d-text) !important;\n  /* Row headers (System and MCU information) are labels, not data. */\n}\n.v-data-table > .v-data-table__wrapper > table > thead > tr > th {\n  color: var(--m3d-text-subtle) !important;\n  font-size: 0.6875rem !important;\n  font-weight: 600 !important;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  white-space: nowrap;\n  border-bottom: 1px solid var(--m3d-border) !important;\n}\n.v-data-table > .v-data-table__wrapper > table > tbody > tr > td,\n.v-data-table > .v-data-table__wrapper > table > tbody > tr > th {\n  border-bottom: 1px solid var(--m3d-border) !important;\n}\n.v-data-table > .v-data-table__wrapper > table > tbody > tr > th {\n  color: var(--m3d-text-muted) !important;\n  font-size: 0.8125rem !important;\n  font-weight: 500 !important;\n}\n.v-data-table > .v-data-table__wrapper > table > tbody > tr:last-child > td,\n.v-data-table > .v-data-table__wrapper > table > tbody > tr:last-child > th {\n  border-bottom: 0 !important;\n}\n.v-data-table > .v-data-table__wrapper > table > tbody > tr:hover:not(.v-data-table__expanded__content):not(.v-data-table__empty-wrapper) {\n  background-color: var(--m3d-hover) !important;\n}\n.v-data-table > .v-data-table__wrapper > table > tbody > tr.v-data-table__selected {\n  background-color: var(--m3d-accent-soft) !important;\n}\n\n.v-data-table.no-hover > .v-data-table__wrapper > table > tbody > tr:hover:not(.v-data-table__expanded__content):not(.v-data-table__empty-wrapper) {\n  background-color: transparent !important;\n}\n\n.v-data-footer {\n  border-top: 1px solid var(--m3d-border) !important;\n  color: var(--m3d-text-muted);\n  font-size: 0.75rem;\n}\n\n/* ------------------------------------------------------ feedback & misc -- */\n.v-alert {\n  border-radius: var(--m3d-radius-md) !important;\n  box-shadow: none !important;\n  font-size: 0.875rem;\n}\n.v-alert.v-alert--text, .v-alert.v-alert--outlined {\n  background-color: var(--m3d-surface) !important;\n  border: 1px solid currentColor !important;\n}\n.v-alert.v-alert--text::before {\n  opacity: 0.08 !important;\n}\n.v-alert.v-alert--outlined::before {\n  opacity: 0 !important;\n}\n.v-alert .v-alert__content {\n  color: var(--m3d-text);\n}\n\n.v-progress-linear {\n  border-radius: 0 !important;\n  overflow: hidden;\n}\n\n.v-progress-linear__background {\n  background-color: var(--m3d-border-strong) !important;\n  opacity: 1 !important;\n}\n\n.v-progress-circular__underlay {\n  stroke: var(--m3d-border) !important;\n}\n\n.v-expansion-panels {\n  border-radius: var(--m3d-radius-md);\n}\n\n.v-expansion-panel {\n  background-color: var(--m3d-surface) !important;\n  color: var(--m3d-text) !important;\n}\n.v-expansion-panel::before {\n  box-shadow: none !important;\n}\n.v-expansion-panel:not(:first-child)::after {\n  border-color: var(--m3d-border) !important;\n  opacity: 1 !important;\n}\n\n.v-expansion-panels:not(.v-expansion-panels--accordion) > .v-expansion-panel {\n  border: 1px solid var(--m3d-border);\n}\n\n.v-expansion-panel-header {\n  font-weight: 600;\n  font-size: 0.875rem;\n}\n\n.v-pagination__item,\n.v-pagination__navigation {\n  background-color: var(--m3d-surface) !important;\n  border: 1px solid var(--m3d-border);\n  border-radius: var(--m3d-radius-sm) !important;\n  box-shadow: none !important;\n  color: var(--m3d-text) !important;\n}\n\n.v-pagination__item--active {\n  background-color: var(--m3d-accent) !important;\n  border-color: var(--m3d-accent);\n}\n\n.v-application .v-skeleton-loader__image,\n.v-application .v-skeleton-loader__text,\n.v-application .v-skeleton-loader__avatar,\n.v-application .v-skeleton-loader__button,\n.v-application .v-skeleton-loader__chip {\n  background: var(--m3d-surface-2) !important;\n  border-radius: var(--m3d-radius-sm) !important;\n}\n\n.v-skeleton-loader__bone::after {\n  background: linear-gradient(90deg, transparent, var(--m3d-hover), transparent) !important;\n}\n\n.v-application--wrap,\n.v-dialog__content {\n  scrollbar-color: var(--m3d-border-strong) transparent;\n  scrollbar-width: thin;\n}\n.v-application--wrap ::-webkit-scrollbar,\n.v-dialog__content ::-webkit-scrollbar {\n  width: 8px;\n  height: 8px;\n}\n.v-application--wrap ::-webkit-scrollbar-thumb,\n.v-dialog__content ::-webkit-scrollbar-thumb {\n  background-color: var(--m3d-border-strong);\n  border: 2px solid transparent;\n  background-clip: padding-box;\n  border-radius: var(--m3d-radius-pill);\n}\n\n.m3d-reduced-motion .v-application *:not(#m3d-motion),\n.m3d-reduced-motion .v-application *:not(#m3d-motion)::before,\n.m3d-reduced-motion .v-application *:not(#m3d-motion)::after {\n  animation-duration: 0.001ms !important;\n  animation-iteration-count: 1 !important;\n  scroll-behavior: auto !important;\n  transition-property: opacity !important;\n}\n\n/*\n * Glass interface style: an Apple-style design built after iOS 27 and macOS\n * 27. Chosen in Settings > Theme and applied as <html data-m3d-style=\"glass\">\n * by src/util/ui-style.ts; nothing here matches while the flat style is on.\n *\n * It is layered on muon3d.scss. Its tokens replace that file's values, and\n * the rules below restyle what a token cannot. The rules it keeps:\n *\n *  - Surfaces are neutral black, white and grey, separated by tone and space,\n *    never by borders. Colour is an accent, and there is one: the theme's\n *    accent on icons and controls. Apple's system colours mark state only\n *    (green on, orange warning, red faults and the E-STOP).\n *  - Icons are line drawings in the manner of SF Symbols (AppGlassIcon).\n *  - Glass is only for chrome that floats over content: menus, tooltips and\n *    the phone tab bar. Cards and dialogs are opaque.\n *  - Glass is painted on ::before where the element holds fixed children,\n *    because backdrop-filter makes an element their containing block.\n *  - Radii nest: an inset of P inside a radius of R uses R - P.\n *  - Scrim opacity is never set here. Vuetify keeps inactive overlays mounted\n *    at opacity 0.\n */\n/* --------------------------------------------------------------- tokens -- */\nhtml[data-m3d-style=glass],\nhtml[data-m3d-style=glass] .v-application {\n  --m3d-font-sans: -apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Inter Variable\", \"Helvetica Neue\", Arial, sans-serif;\n  --m3d-font-title: \"SF Pro Display\", -apple-system, BlinkMacSystemFont, \"Inter Variable\", \"Helvetica Neue\", Arial, sans-serif;\n  --m3d-font-rounded: ui-rounded, \"SF Pro Rounded\", -apple-system, BlinkMacSystemFont, \"Inter Variable\", sans-serif;\n  --m3d-font-mono: ui-monospace, \"SF Mono\", SFMono-Regular, Menlo, Consolas, monospace;\n  --m3d-radius-xs: 6px;\n  --m3d-radius-sm: 10px;\n  --m3d-radius-float: 14px;\n  --m3d-radius-md: 22px;\n  --m3d-radius-lg: 28px;\n  --m3d-radius-xl: 28px;\n  --m3d-radius-2xl: 28px;\n  --m3d-radius-pill: 999px;\n  --m3d-duration-fast: var(--m3d-motion-fast);\n  --m3d-duration-base: var(--m3d-motion-base);\n  --m3d-ease: var(--m3d-ease-standard);\n  --m3d-spring: cubic-bezier(0.34, 1.36, 0.64, 1);\n  --m3d-tracking-caps: 0;\n  --m3d-tracking-eyebrow: 0;\n  --m3d-glass-filter: blur(28px) saturate(190%);\n  --m3d-accent-soft: color-mix(in srgb, var(--m3d-accent) 16%, transparent);\n  --m3d-focus-ring: color-mix(in srgb, var(--m3d-accent) 55%, transparent);\n  --m3d-ring-track: color-mix(in srgb, var(--m3d-accent) 20%, transparent);\n  --m3d-estop: #e0241f;\n}\n\nhtml[data-m3d-style=glass],\nhtml[data-m3d-style=glass] .v-application.theme--dark {\n  --m3d-sys-red: rgb(255 66 69);\n  --m3d-sys-orange: rgb(255 146 48);\n  --m3d-sys-green: rgb(48 209 88);\n  --m3d-bg: #000;\n  --m3d-surface: #1c1c1e;\n  --m3d-surface-2: #2c2c2e;\n  --m3d-inset: rgb(118 118 128 / 24%);\n  --m3d-raised: #2c2c2e;\n  --m3d-sidebar: rgb(28 28 30 / 78%);\n  --m3d-fill: rgb(118 118 128 / 24%);\n  --m3d-fill-2: rgb(118 118 128 / 14%);\n  --m3d-fill-strong: rgb(118 118 128 / 36%);\n  --m3d-border: rgb(84 84 88 / 48%);\n  --m3d-border-strong: rgb(84 84 88 / 80%);\n  --m3d-text: #f5f5f7;\n  --m3d-text-muted: #98989d;\n  --m3d-text-subtle: #636366;\n  --m3d-hover: rgb(255 255 255 / 6%);\n  --m3d-success: var(--m3d-sys-green);\n  --m3d-warning: var(--m3d-sys-orange);\n  --m3d-danger: var(--m3d-sys-red);\n  --m3d-overlay: #000;\n  --m3d-segment: #636366;\n  --m3d-switch-off: rgb(120 120 128 / 32%);\n  --m3d-glass: rgb(44 44 48 / 56%);\n  --m3d-glass-thick: rgb(38 38 42 / 82%);\n  --m3d-glass-rim: inset 0 0.5px 0 rgb(255 255 255 / 24%), inset 0 0 0 0.5px rgb(255 255 255 / 10%);\n  --m3d-glass-edge: 0 0 0 0.5px rgb(0 0 0 / 70%);\n  --m3d-shadow-float: 0 18px 44px rgb(0 0 0 / 50%), 0 2px 8px rgb(0 0 0 / 30%);\n  --m3d-shadow-control: 0 3px 8px rgb(0 0 0 / 28%), 0 0.5px 1.5px rgb(0 0 0 / 36%);\n}\n\nhtml[data-m3d-style=glass] .v-application.theme--light {\n  --m3d-sys-red: rgb(255 56 60);\n  --m3d-sys-orange: rgb(255 141 40);\n  --m3d-sys-green: rgb(52 199 89);\n  --m3d-bg: #f2f2f7;\n  --m3d-surface: #fff;\n  --m3d-surface-2: #f2f2f7;\n  --m3d-inset: rgb(118 118 128 / 12%);\n  --m3d-raised: #fff;\n  --m3d-sidebar: rgb(230 230 235 / 80%);\n  --m3d-fill: rgb(118 118 128 / 12%);\n  --m3d-fill-2: rgb(118 118 128 / 7%);\n  --m3d-fill-strong: rgb(118 118 128 / 20%);\n  --m3d-border: rgb(60 60 67 / 13%);\n  --m3d-border-strong: rgb(60 60 67 / 24%);\n  --m3d-text: #1d1d1f;\n  --m3d-text-muted: #6e6e73;\n  --m3d-text-subtle: #aeaeb2;\n  --m3d-hover: rgb(0 0 0 / 4%);\n  --m3d-success: rgb(0 137 50);\n  --m3d-warning: rgb(201 52 0);\n  --m3d-danger: rgb(215 0 21);\n  --m3d-overlay: #000;\n  --m3d-segment: #fff;\n  --m3d-switch-off: rgb(120 120 128 / 16%);\n  --m3d-glass: rgb(255 255 255 / 62%);\n  --m3d-glass-thick: rgb(252 252 253 / 86%);\n  --m3d-glass-rim: inset 0 0.5px 0 rgb(255 255 255 / 95%), inset 0 0 0 0.5px rgb(255 255 255 / 55%);\n  --m3d-glass-edge: 0 0 0 0.5px rgb(0 0 0 / 9%);\n  --m3d-shadow-float: 0 14px 36px rgb(0 0 0 / 12%), 0 2px 6px rgb(0 0 0 / 6%);\n  --m3d-shadow-control: 0 3px 8px rgb(0 0 0 / 12%), 0 0.5px 1.5px rgb(0 0 0 / 14%);\n}\n\nhtml[data-m3d-style=glass]:has(.v-application.theme--light) {\n  --m3d-bg: #f2f2f7;\n}\n\n@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {\n  html[data-m3d-style=glass],\nhtml[data-m3d-style=glass] .v-application.theme--dark,\nhtml[data-m3d-style=glass] .v-application.theme--light {\n    --m3d-glass: var(--m3d-surface);\n    --m3d-glass-thick: var(--m3d-raised);\n    --m3d-sidebar: var(--m3d-surface);\n  }\n}\n@media (prefers-reduced-transparency: reduce) {\n  html[data-m3d-style=glass],\nhtml[data-m3d-style=glass] .v-application.theme--dark,\nhtml[data-m3d-style=glass] .v-application.theme--light {\n    --m3d-glass: var(--m3d-surface);\n    --m3d-glass-thick: var(--m3d-raised);\n    --m3d-sidebar: var(--m3d-surface);\n    --m3d-glass-filter: none;\n  }\n}\n@media (prefers-contrast: more) {\n  html[data-m3d-style=glass],\nhtml[data-m3d-style=glass] .v-application.theme--dark,\nhtml[data-m3d-style=glass] .v-application.theme--light {\n    --m3d-border: var(--m3d-border-strong);\n    --m3d-glass-edge: 0 0 0 1px var(--m3d-border-strong);\n    --m3d-text-muted: var(--m3d-text);\n  }\n}\nhtml[data-m3d-style=glass] {\n  scrollbar-color: color-mix(in srgb, var(--m3d-text) 28%, transparent) transparent;\n  /* ------------------------------------------------------------- type -- */\n  /* ------------------------------------------------------------- rail -- */\n  /* ------------------------------------------------------------ content -- */\n  /* -------------------------------------------------------------- cards -- */\n  /* ---------------------------------------------- settings (inset lists) -- */\n  /* ----------------------------------------------------------- floating -- */\n  /* ------------------------------------------------------------ buttons -- */\n  /* -------------------------------------------------------- lists, tabs -- */\n  /* ------------------------------------------------------------- inputs -- */\n  /* --------------------------------------------------